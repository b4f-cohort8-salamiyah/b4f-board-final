# Copy this file to .env and fill in real local values. Never commit .env.

# The Nest API base URL, used by the server-only typed API client
# (see src/lib/api/). Never exposed to the browser directly.
NEST_API_URL="http://localhost:4000"

# Standard Node environment flag. Controls things like the session cookie's
# `secure` attribute (see src/lib/session) - "development" for local use.
# The actual session token is the Nest-issued JWT, stored in an HttpOnly
# cookie; see ../../projects/b4f-board/specification/FRONTEND-ARCHITECTURE.md.
NODE_ENV="development"
