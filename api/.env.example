# Copy this file to .env and fill in real local values. Never commit .env.

# PostgreSQL connection string (Prisma format).
# The instructor preview uses an isolated, project-local Postgres instance -
# see api/README.md, "Local database setup" for how it was created. Replace
# <your-username> with the OS user that ran `initdb`/`createdb` there (on
# most local setups this is just your own machine username - run `whoami`
# if unsure). This is never a real production credential.
#
# `npm run seed` refuses to run its destructive reset unless this URL's
# host/port/database name match the dedicated local preview database
# (localhost/127.0.0.1, port 5433, database "b4f_board") - see
# src/common/seed-safety.util.ts and README.md. Keep this value pointed at
# that instance.
DATABASE_URL="postgresql://<your-username>@localhost:5433/b4f_board?schema=public"

# Port the Nest API listens on.
PORT=4000

# Origin(s) allowed to call this API with credentials (the Next.js web app).
WEB_ORIGIN="http://localhost:3000"

# JWT signing secret. This is a demo-only value for the local teaching preview -
# never reuse it anywhere real. Generate a real random secret for any non-local use.
JWT_SECRET="b4f-board-local-preview-demo-secret-do-not-use-in-production"

# Access-token lifetime - see specification/AUTH-AND-PERMISSIONS.md for the ~8h teaching rationale.
JWT_EXPIRES_IN="8h"
